# AI SaaS Dashboard - Environment Variables
# Copy this file to .env.local and fill in your actual values

# ============================================
# App Configuration
# ============================================
NEXT_PUBLIC_APP_NAME=AI Content Suite
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Database Configuration
# ============================================
# Using SQLite for development - change to PostgreSQL for production
DATABASE_URL="file:./dev.db"

# ============================================
# 3-Layer Authentication
# ============================================
# These are set during initial admin setup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH= # bcrypt hash of admin password
ADMIN_SECURITY_QUESTION= # e.g., "What is your mother's maiden name?"
ADMIN_SECURITY_ANSWER_HASH= # bcrypt hash of security answer
ADMIN_SECRET_KEY_HASH= # bcrypt hash of secret key

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# ============================================
# OpenRouter AI Integration
# ============================================
# Get API key from https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-xxx

# Model Configuration
OPENROUTER_FAST_MODEL=openai/gpt-4o-mini
OPENROUTER_QUALITY_MODEL=openai/gpt-4o
OPENROUTER_BLOG_MODEL=anthropic/claude-3-5-sonnet-20241022
OPENROUTER_CODE_MODEL=deepseek/deepseek-coder

# ============================================
# Image Generation APIs
# ============================================
# Replicate API (for AI image generation)
REPLICATE_API_TOKEN=r8_xxx
REPLICATE_API_KEY=r8_xxx

# Stability AI (alternative image generation)
STABILITY_API_KEY=sk-stb-xxx

# ============================================
# Rate Limiting & Security
# ============================================
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
ADMIN_RATE_LIMIT_MAX=10
ADMIN_RATE_LIMIT_WINDOW_MS=60000

# Session timeout (minutes)
SESSION_TIMEOUT=120

# ============================================
# File Storage
# ============================================
# For production, consider using Vercel Blob, AWS S3, or Cloudinary
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB

# ============================================
# Logging & Monitoring
# ============================================
LOG_LEVEL=info  # error, warn, info, debug
ENABLE_AUDIT_LOG=true

# Optional: Sentry for error tracking
# SENTRY_DSN=https://xxx@sentry.io/project-id

# Optional: Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# Feature Flags
# ============================================
ENABLE_CAMPAIGNS=true
ENABLE_BULK_PROCESSING=true
ENABLE_PIN_STUDIO=true
ENABLE_ASSET_LIBRARY=true
ENABLE_EXPORT=true

# ============================================
# Campaign Automation
# ============================================
# Queue configuration (for future Redis/Bull upgrade)
QUEUE_CONCURRENCY=3
CAMPAIGN_RETRY_ATTEMPTS=3
CAMPAIGN_RETRY_DELAY=5000  # ms

# ============================================
# Development & Debug
# ============================================
# Uncomment for local development
# NEXT_PUBLIC_APP_ENV=development
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_DEBUG=true
# LOG_LEVEL=debug