# Pinterest Pin Generator - Production Environment Variables
# Use these in Vercel Dashboard → Settings → Environment Variables

# ============================================
# REQUIRED: App Configuration
# ============================================
NEXT_PUBLIC_APP_NAME=PinSpark
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=https://pinterest-pin-generator.vercel.app

# ============================================
# REQUIRED: Replicate API (AI Generation)
# ============================================
# Get your API key from: https://replicate.com/account/api-tokens
NEXT_PUBLIC_REPLICATE_API_KEY=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# OPTIONAL: Google AdSense
# ============================================
# Get these from: https://www.google.com/adsense
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_HEADER_SLOT_ID=1234567890
NEXT_PUBLIC_ADSENSE_RESPONSIVE_SLOT_ID=0987654321
NEXT_PUBLIC_ENABLE_ADSENSE=true

# ============================================
# OPTIONAL: Viads
# ============================================
# Get these from your Viads account
NEXT_PUBLIC_VIADS_PUBLISHER_ID=your_viads_publisher_id
NEXT_PUBLIC_VIADS_VIDEO_PLACEMENT_ID=placement_video_id
NEXT_PUBLIC_VIADS_INTERSTITIAL_PLACEMENT_ID=placement_interstitial_id
NEXT_PUBLIC_VIADS_BANNER_PLACEMENT_ID=placement_banner_id
NEXT_PUBLIC_ENABLE_VIADS=true

# ============================================
# Feature Flags
# ============================================
NEXT_PUBLIC_AD_DEBUG_MODE=false

# ============================================
# INSTRUCTIONS FOR VERCEL:
# ============================================
# 1. Go to Vercel Dashboard
# 2. Select your project
# 3. Go to Settings → Environment Variables
# 4. Add each variable above
# 5. Select environments:
#    - ✅ Production
#    - ✅ Preview
#    - ❌ Development (use .env.local instead)
# 6. Mark sensitive variables as "Sensitive":
#    - REPLICATE_API_TOKEN
#    - Any API keys containing secrets
# 7. Click "Save"
# 8. Redeploy your application
# ============================================
