# GitHub Actions CI Workflow (Example)
# Rename this file to ci.yml to enable CI checks
# This is disabled by default as Vercel handles deployment automatically

name: CI

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main, develop ]

jobs:
  build:
    runs-on: ubuntu-latest

    strategy:
      matrix:
        node-version: [18.x, 20.x]

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup Node.js ${{ matrix.node-version }}
      uses: actions/setup-node@v4
      with:
        node-version: ${{ matrix.node-version }}
        cache: 'npm'

    - name: Install dependencies
      run: npm ci

    - name: Run linter
      run: npm run lint

    - name: Build application
      run: npm run build
      env:
        NEXT_PUBLIC_APP_NAME: PinSpark
        NEXT_PUBLIC_APP_ENV: production

    - name: Check bundle size
      run: |
        echo "Build completed successfully!"
        ls -lh .next/static/

# Note: Vercel automatically handles deployment, so this workflow
# is optional and only for additional CI checks before merge
